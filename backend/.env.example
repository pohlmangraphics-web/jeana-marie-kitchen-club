# Backend Environment (copy to .env and fill in real values)
MONGO_URL="mongodb://localhost:27017"
DB_NAME="kitchen_club"
CORS_ORIGINS="*"

# JWT signing secret — generate a strong random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET="change-me-to-a-long-random-string"

# Stripe (from your claimed Stripe account or Emergent-managed sandbox)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_ACCOUNT_ID="acct_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_MODE="test"

# Emergent-managed integrations
EMERGENT_LLM_KEY="sk-emergent-..."
APP_NAME="jeana-marie-kitchen-club"
